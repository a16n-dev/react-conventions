---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Content as Readme } from "../../README.md";
import { getAllTags, getHtmlPath, getPublishedGuardrails, getSummary } from "../lib/guardrails";

const guardrails = await getPublishedGuardrails();
const tags = getAllTags(guardrails);
---

<BaseLayout
  title="React Conventions"
  description="An opinionated set of conventions for React codebases built with coding agents."
>
  <div class="intro">
    <Readme />
  </div>

  <aside class="llm-callout">
    <strong>Using an agent?</strong> Point it at
    <a href="/llms-full.txt"><code>/llms-full.txt</code></a> for every convention in one file, or
    <a href="/llms.txt"><code>/llms.txt</code></a> for an index. Each convention is also available as
    markdown by adding <code>.md</code> to its URL.
  </aside>

  <h2 id="conventions">Conventions <span class="count">{guardrails.length}</span></h2>

  <div class="filters" role="group" aria-label="Filter by tag">
    <button class="tag" type="button" data-tag="" aria-pressed="true">All</button>
    {
      tags.map((tag) => (
        <button class="tag" type="button" data-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))
    }
  </div>

  <ol class="guardrail-list">
    {
      guardrails.map((guardrail) => (
        <li data-tags={JSON.stringify(guardrail.data.tags)}>
          <a href={getHtmlPath(guardrail)}>{guardrail.data.title}</a>
          <p>{getSummary(guardrail)}</p>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filters button");
  const items = document.querySelectorAll<HTMLLIElement>(".guardrail-list li");

  function applyFilter(tag: string) {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.tag === tag));
    }
    for (const item of items) {
      const itemTags: string[] = JSON.parse(item.dataset.tags ?? "[]");
      item.hidden = tag !== "" && !itemTags.includes(tag);
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const tag = button.dataset.tag ?? "";
      applyFilter(tag);
      const url = new URL(location.href);
      if (tag) {
        url.searchParams.set("tag", tag);
      } else {
        url.searchParams.delete("tag");
      }
      history.replaceState(null, "", url);
    });
  }

  applyFilter(new URL(location.href).searchParams.get("tag") ?? "");
</script>

<style>
  .intro :global(h1) {
    margin-top: 32px;
  }

  .llm-callout {
    margin: 32px 0;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font-size: 15px;
  }

  .count {
    color: var(--muted);
    font-weight: 400;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .filters button {
    cursor: pointer;
  }

  .filters button[aria-pressed="true"] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .guardrail-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .guardrail-list li {
    padding: 14px 0;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  .guardrail-list a {
    color: var(--fg);
    font-weight: 600;
  }

  .guardrail-list a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .guardrail-list p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
